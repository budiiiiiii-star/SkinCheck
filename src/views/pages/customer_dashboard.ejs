<!-- Customer Dashboard -->

<!-- Hero Banner -->
<div class="hero-banner slide-up">
    <div class="hero-banner-content">
        <h1 class="hero-banner-title">Halo, <%= user.name %>! 👋</h1>
        <p class="hero-banner-subtitle">
            Selamat datang di pusat pemantauan visual kulit berbasis kecerdasan buatan.
        </p>
        <div class="hero-banner-actions">
            <a href="/scan" class="btn btn-solid" id="dash-face-scan-btn">
                <i class="fa-solid fa-camera"></i>
                Face Scan
            </a>
            <a href="/sunscreen/scan" class="btn btn-glass" id="dash-sunscreen-btn">
                <i class="fa-solid fa-sun"></i>
                Cek Sunscreen
            </a>
            <a href="/customer/recommendations" class="btn btn-glass" id="dash-recs-btn">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                Rekomendasi
            </a>
        </div>
    </div>
</div>

<!-- Sunscreen Alert (jika ada data) -->
<% if (latestSunscreen) { %>
<div class="sc-card p-3 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3"
     style="border-left:4px solid var(--accent);background:rgba(6,182,212,0.06);">
    <div class="d-flex align-items-center gap-3">
        <div style="width:40px;height:40px;border-radius:12px;background:rgba(6,182,212,0.15);display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:1.1rem;flex-shrink:0;">
            <i class="fa-solid fa-sun"></i>
        </div>
        <div>
            <div style="font-weight:700;font-size:0.875rem;color:var(--text-primary);">Sunscreen Check Terakhir</div>
            <div style="font-size:0.8rem;color:var(--text-secondary);">
                <%= new Date(latestSunscreen.scan_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'short' }) %>
                &nbsp;·&nbsp; Status: <strong style="color:var(--accent);"><%= latestSunscreen.coverage_status %> (<%= latestSunscreen.coverage_score %>%)</strong>
            </div>
        </div>
    </div>
    <a href="/sunscreen/result/<%= latestSunscreen.skin_scan_id %>" class="btn btn-outline btn-sm" id="dash-sunscreen-result-btn">
        Lihat Detail
    </a>
</div>
<% } %>

<!-- Skin Progress Section -->
<div style="margin-bottom:20px;">
    <h2 style="font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:4px;">Perkembangan Visual Kulit</h2>
    <p style="font-size:0.8rem;color:var(--text-muted);margin-bottom:20px;">Perbandingan baseline, sebelumnya, dan kondisi terbaru kulit Anda.</p>

    <% if (!history || history.length === 0) { %>
        <!-- Empty State -->
        <div style="background:var(--bg-card);border:1px solid var(--border-color);border-radius:18px;padding:60px 24px;text-align:center;">
            <div style="width:64px;height:64px;border-radius:20px;background:rgba(124,58,237,0.1);display:flex;align-items:center;justify-content:center;color:var(--brand-primary);font-size:1.5rem;margin:0 auto 16px;">
                <i class="fa-solid fa-clipboard-list"></i>
            </div>
            <h3 style="font-size:1.1rem;font-weight:700;color:var(--text-primary);margin-bottom:8px;">Belum Ada History Scan</h3>
            <p style="font-size:0.875rem;color:var(--text-muted);max-width:340px;margin:0 auto 24px;">Lakukan Face Scan pertama Anda untuk menetapkan <em>Baseline</em> visual kulit dan mulai tracking progress.</p>
            <a href="/scan" class="btn btn-primary" id="dash-first-scan-btn">
                <i class="fa-solid fa-camera"></i> Mulai Face Scan
            </a>
        </div>
    <% } else { %>
        <!-- Progress Cards Grid -->
        <div class="row g-4">

            <!-- Baseline -->
            <div class="col-md-4">
                <div style="background:var(--bg-card);border:1px solid var(--border-color);border-radius:18px;overflow:hidden;box-shadow:var(--shadow-sm);transition:all 0.3s ease;height:100%;" onmouseenter="this.style.boxShadow='var(--shadow-md)';this.style.transform='translateY(-2px)'" onmouseleave="this.style.boxShadow='var(--shadow-sm)';this.style.transform='translateY(0)'">
                    <div style="padding:16px 20px;border-bottom:1px solid var(--border-color);">
                        <span style="display:inline-flex;align-items:center;gap:6px;padding:3px 10px;border-radius:99px;background:rgba(100,116,139,0.1);color:#64748b;font-size:0.72rem;font-weight:600;margin-bottom:8px;">
                            <i class="fa-solid fa-flag"></i> Baseline (Scan Pertama)
                        </span>
                        <div style="font-size:0.8rem;color:var(--text-muted);">
                            <%= new Date(baseline.scan_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                        </div>
                    </div>
                    <div style="padding:20px;">
                        <% const baseMetrics = [
                            { label: 'Blemish', val: baseline.acne_score },
                            { label: 'Redness', val: baseline.redness_score },
                            { label: 'Texture', val: baseline.texture_score },
                            { label: 'Pigmentation', val: baseline.hyperpigmentation_score }
                        ]; %>
                        <% baseMetrics.forEach(m => { %>
                            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
                                <span style="font-size:0.8rem;color:var(--text-secondary);font-weight:500;"><%= m.label %></span>
                                <span style="font-size:0.8rem;font-weight:700;color:var(--text-primary);"><%= m.val %></span>
                            </div>
                        <% }) %>
                        <div style="border-top:1px solid var(--border-color);margin-top:12px;padding-top:12px;display:flex;justify-content:space-between;align-items:center;">
                            <span style="font-size:0.875rem;font-weight:700;color:var(--text-primary);">Overall Score</span>
                            <span style="font-size:1rem;font-weight:800;color:var(--brand-primary);"><%= baseline.overall_score %></span>
                        </div>
                    </div>
                    <div style="padding:12px 20px;border-top:1px solid var(--border-color);text-align:center;">
                        <a href="/analysis/<%= baseline.skin_scan_id %>" class="btn btn-secondary btn-sm" id="dash-baseline-result-btn">Buka Hasil</a>
                    </div>
                </div>
            </div>

            <!-- Previous -->
            <div class="col-md-4">
                <% if (previous) { %>
                    <div style="background:var(--bg-card);border:1px solid var(--border-color);border-radius:18px;overflow:hidden;box-shadow:var(--shadow-sm);transition:all 0.3s ease;height:100%;" onmouseenter="this.style.boxShadow='var(--shadow-md)';this.style.transform='translateY(-2px)'" onmouseleave="this.style.boxShadow='var(--shadow-sm)';this.style.transform='translateY(0)'">
                        <div style="padding:16px 20px;border-bottom:1px solid var(--border-color);">
                            <span style="display:inline-flex;align-items:center;gap:6px;padding:3px 10px;border-radius:99px;background:rgba(6,182,212,0.1);color:#06b6d4;font-size:0.72rem;font-weight:600;margin-bottom:8px;">
                                <i class="fa-solid fa-clock-rotate-left"></i> Previous Scan
                            </span>
                            <div style="font-size:0.8rem;color:var(--text-muted);">
                                <%= new Date(previous.scan_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                            </div>
                        </div>
                        <div style="padding:20px;">
                            <% const prevMetrics = [
                                { label: 'Blemish', val: previous.acne_score },
                                { label: 'Redness', val: previous.redness_score },
                                { label: 'Texture', val: previous.texture_score },
                                { label: 'Pigmentation', val: previous.hyperpigmentation_score }
                            ]; %>
                            <% prevMetrics.forEach(m => { %>
                                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
                                    <span style="font-size:0.8rem;color:var(--text-secondary);font-weight:500;"><%= m.label %></span>
                                    <span style="font-size:0.8rem;font-weight:700;color:var(--text-primary);"><%= m.val %></span>
                                </div>
                            <% }) %>
                            <div style="border-top:1px solid var(--border-color);margin-top:12px;padding-top:12px;display:flex;justify-content:space-between;align-items:center;">
                                <span style="font-size:0.875rem;font-weight:700;color:var(--text-primary);">Overall Score</span>
                                <span style="font-size:1rem;font-weight:800;color:#06b6d4;"><%= previous.overall_score %></span>
                            </div>
                        </div>
                        <div style="padding:12px 20px;border-top:1px solid var(--border-color);text-align:center;">
                            <a href="/analysis/<%= previous.skin_scan_id %>" class="btn btn-secondary btn-sm" id="dash-prev-result-btn">Buka Hasil</a>
                        </div>
                    </div>
                <% } else { %>
                    <div style="background:var(--bg-surface-2);border:1px dashed var(--border-color);border-radius:18px;height:100%;min-height:250px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:32px;">
                        <div style="width:48px;height:48px;border-radius:14px;background:var(--bg-input);display:flex;align-items:center;justify-content:center;color:var(--text-muted);font-size:1.1rem;margin-bottom:12px;">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                        </div>
                        <p style="font-size:0.8rem;color:var(--text-muted);margin:0;">Lakukan scan kedua untuk membuka perbandingan tren.</p>
                    </div>
                <% } %>
            </div>

            <!-- Current (Latest) -->
            <div class="col-md-4">
                <div style="background:var(--bg-card);border:2px solid var(--brand-primary);border-radius:18px;overflow:hidden;box-shadow:0 0 0 4px rgba(124,58,237,0.08);transition:all 0.3s ease;height:100%;position:relative;" onmouseenter="this.style.boxShadow='var(--shadow-md)';this.style.transform='translateY(-2px)'" onmouseleave="this.style.boxShadow='0 0 0 4px rgba(124,58,237,0.08)';this.style.transform='translateY(0)'">
                    <div style="position:absolute;top:12px;right:14px;font-size:1rem;color:#f59e0b;">
                        <i class="fa-solid fa-star"></i>
                    </div>
                    <div style="padding:16px 20px;border-bottom:1px solid var(--border-color);">
                        <span style="display:inline-flex;align-items:center;gap:6px;padding:3px 10px;border-radius:99px;background:var(--brand-gradient);color:white;font-size:0.72rem;font-weight:600;margin-bottom:8px;">
                            <i class="fa-solid fa-star"></i> Latest (Terbaru)
                        </span>
                        <div style="font-size:0.8rem;color:var(--text-muted);">
                            <%= new Date(current.scan_date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                        </div>
                    </div>
                    <div style="padding:20px;">
                        <%
                            const getTrendIcon = (val) => {
                                if (val > 0) return '<i class="fa-solid fa-arrow-trend-up" style="color:#10b981;margin-left:4px;font-size:0.7rem;"></i>';
                                if (val < 0) return '<i class="fa-solid fa-arrow-trend-down" style="color:#ef4444;margin-left:4px;font-size:0.7rem;"></i>';
                                return '<i class="fa-solid fa-minus" style="color:var(--text-muted);margin-left:4px;font-size:0.7rem;"></i>';
                            }
                        %>
                        <% const curMetrics = [
                            { label: 'Blemish', val: current.acne_score, key: 'acne' },
                            { label: 'Redness', val: current.redness_score, key: 'redness' },
                            { label: 'Texture', val: current.texture_score, key: 'texture' },
                            { label: 'Pigmentation', val: current.hyperpigmentation_score, key: 'hyperpigmentation' }
                        ]; %>
                        <% curMetrics.forEach(m => { %>
                            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
                                <span style="font-size:0.8rem;color:var(--text-secondary);font-weight:500;"><%= m.label %></span>
                                <span style="font-size:0.8rem;font-weight:700;color:var(--text-primary);display:flex;align-items:center;">
                                    <%= m.val %> <%- trend ? getTrendIcon(trend[m.key]) : '' %>
                                </span>
                            </div>
                        <% }) %>
                        <div style="border-top:1px solid var(--border-color);margin-top:12px;padding-top:12px;display:flex;justify-content:space-between;align-items:center;">
                            <span style="font-size:0.875rem;font-weight:700;color:var(--text-primary);">Overall Score</span>
                            <span style="font-size:1rem;font-weight:800;color:var(--brand-primary);display:flex;align-items:center;">
                                <%= current.overall_score %> <%- trend ? getTrendIcon(trend.overall) : '' %>
                            </span>
                        </div>
                    </div>
                    <div style="padding:12px 20px;border-top:1px solid var(--border-color);text-align:center;">
                        <a href="/analysis/<%= current.skin_scan_id %>" class="btn btn-primary btn-sm" id="dash-current-result-btn">Buka Hasil</a>
                    </div>
                </div>
            </div>

        </div>

        <!-- Disclaimer -->
        <div style="margin-top:20px;background:var(--bg-surface-2);border:1px solid var(--border-color);border-radius:14px;padding:12px 16px;font-size:0.8rem;color:var(--text-muted);">
            <i class="fa-solid fa-circle-info me-2" style="color:var(--brand-primary);"></i>
            <strong>Catatan Penting:</strong> Perubahan angka dan tren panah di atas adalah indikator <strong>perubahan visual</strong> yang dibaca oleh sistem — bukan tingkat penyembuhan atau perburukan medis.
        </div>
    <% } %>
</div>
