# Konfigurasi Server
PORT=3000
NODE_ENV=development

# Konfigurasi Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=skincheck_db

# Rahasia JWT
SESSION_SECRET=your_session_secret
JWT_SECRET=your_jwt_secret

# ============================================================
# AI Provider Configuration
# Pilih satu provider aktif: nvidia | gemini | openai | anthropic | groq | ollama
# ============================================================
AI_PROVIDER=nvidia

# NVIDIA NIM API (https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# Anthropic Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-haiku-4-5

# Groq (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (lokal, tidak perlu API key)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Fonnte WhatsApp API
# Dapatkan token dari: https://app.fonnte.com/account
FONNTE_API_KEY=your_fonnte_device_token
FONNTE_API_URL=https://api.fonnte.com
