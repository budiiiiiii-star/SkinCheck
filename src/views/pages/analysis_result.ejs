<!-- Analysis Result Page -->
<div class="slide-up">

    <!-- Disclaimer -->
    <div class="alert alert-warning mb-4">
        <h6 style="font-weight:700;margin-bottom:6px;"><i class="fa-solid fa-circle-info me-2"></i>Disclaimer Penting</h6>
        <p style="margin:0;font-size:0.8rem;color:var(--text-secondary);">
            Hasil analisis ini merupakan <strong>indikasi visual</strong> yang dihasilkan oleh sistem secara otomatis dan <strong>bukan merupakan diagnosis medis</strong>.
            SkinCheck tidak dapat menggantikan peran dokter atau tenaga kesehatan profesional. Jika Anda memiliki keluhan kulit yang serius, segera konsultasikan ke Dermatologist.
        </p>
    </div>

    <!-- Main Card -->
    <div style="background:var(--bg-card);border:1px solid var(--border-color);border-radius:20px;overflow:hidden;box-shadow:var(--shadow-md);">

        <!-- Card Header -->
        <div style="background:linear-gradient(135deg,#10b981,#059669);padding:22px 28px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
            <div>
                <h2 style="font-weight:800;color:white;margin-bottom:4px;font-size:1.25rem;">
                    <i class="fa-solid fa-chart-pie me-2"></i>Hasil Analisis Kulit
                </h2>
                <p style="margin:0;font-size:0.8rem;color:rgba(255,255,255,0.8);">
                    Tanggal Scan: <%= new Date(scan.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute:'2-digit' }) %>
                </p>
            </div>
            <div style="background:rgba(255,255,255,0.2);border:1px solid rgba(255,255,255,0.3);border-radius:14px;padding:10px 18px;text-align:center;">
                <div style="font-size:0.7rem;color:rgba(255,255,255,0.8);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:2px;">Overall Score</div>
                <div style="font-size:1.8rem;font-weight:800;color:white;line-height:1;"><%= analysis.overall_score %><span style="font-size:0.9rem;">/100</span></div>
            </div>
        </div>

        <!-- Card Body -->
        <div style="padding:28px;">
            <div class="row g-5">

                <!-- Left: Photo -->
                <div class="col-md-5 text-center">
                    <h6 style="font-weight:600;color:var(--text-muted);font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:16px;">Foto Referensi</h6>
                    <div style="border-radius:16px;overflow:hidden;border:2px solid var(--border-color);box-shadow:var(--shadow-sm);display:inline-block;">
                        <img src="/scan/image/<%= scan.id %>" alt="Face Scan" style="max-width:100%;display:block;object-fit:cover;">
                    </div>
                </div>

                <!-- Right: Indicators -->
                <div class="col-md-7">
                    <h6 style="font-weight:600;color:var(--text-muted);font-size:0.75rem;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:20px;">Indikator Kondisi Visual</h6>

                    <!-- Acne -->
                    <div style="margin-bottom:20px;">
                        <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
                            <span style="font-size:0.875rem;font-weight:600;color:var(--text-primary);">Blemish / Breakout (Acne-like)</span>
                            <span style="font-size:0.875rem;font-weight:700;color:var(--brand-primary);"><%= analysis.acne_score %>/100</span>
                        </div>
                        <div class="progress" style="height:8px;">
                            <div class="progress-bar bg-primary" style="width:<%= analysis.acne_score %>%"></div>
                        </div>
                        <small style="font-size:0.75rem;color:var(--text-muted);margin-top:4px;display:block;"><%= analysis.ai_response.acne_description %></small>
                    </div>

                    <!-- Redness -->
                    <div style="margin-bottom:20px;">
                        <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
                            <span style="font-size:0.875rem;font-weight:600;color:var(--text-primary);">Kemerahan (Redness)</span>
                            <span style="font-size:0.875rem;font-weight:700;color:#ef4444;"><%= analysis.redness_score %>/100</span>
                        </div>
                        <div class="progress" style="height:8px;">
                            <div class="progress-bar bg-danger" style="width:<%= analysis.redness_score %>%"></div>
                        </div>
                        <small style="font-size:0.75rem;color:var(--text-muted);margin-top:4px;display:block;"><%= analysis.ai_response.redness_description %></small>
                    </div>

                    <!-- Texture -->
                    <div style="margin-bottom:20px;">
                        <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
                            <span style="font-size:0.875rem;font-weight:600;color:var(--text-primary);">Tekstur Kulit (Texture)</span>
                            <span style="font-size:0.875rem;font-weight:700;color:#f59e0b;"><%= analysis.texture_score %>/100</span>
                        </div>
                        <div class="progress" style="height:8px;">
                            <div class="progress-bar bg-warning" style="width:<%= analysis.texture_score %>%"></div>
                        </div>
                        <small style="font-size:0.75rem;color:var(--text-muted);margin-top:4px;display:block;"><%= analysis.ai_response.texture_description %></small>
                    </div>

                    <!-- Hyperpigmentation -->
                    <div style="margin-bottom:20px;">
                        <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
                            <span style="font-size:0.875rem;font-weight:600;color:var(--text-primary);">Hiperpigmentasi (Noda Gelap)</span>
                            <span style="font-size:0.875rem;font-weight:700;color:#06b6d4;"><%= analysis.hyperpigmentation_score %>/100</span>
                        </div>
                        <div class="progress" style="height:8px;">
                            <div class="progress-bar bg-info" style="width:<%= analysis.hyperpigmentation_score %>%"></div>
                        </div>
                        <small style="font-size:0.75rem;color:var(--text-muted);margin-top:4px;display:block;"><%= analysis.ai_response.hyperpigmentation_description %></small>
                    </div>

                    <!-- Summary Box -->
                    <div style="background:var(--bg-surface-2);border:1px solid var(--border-color);border-radius:14px;padding:16px;">
                        <div style="font-size:0.75rem;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:8px;">Ringkasan Analisis</div>
                        <p style="margin:0;font-size:0.875rem;color:var(--text-primary);line-height:1.6;"><%= analysis.ai_response.summary %></p>
                    </div>
                </div>

            </div>

            <!-- Action Buttons -->
            <div style="margin-top:32px;display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
                <a href="/customer/dashboard" class="btn btn-secondary btn-lg" id="analysis-back-btn">
                    <i class="fa-solid fa-arrow-left"></i> Kembali ke Dashboard
                </a>
                <a href="/ai/chat" class="btn btn-primary btn-lg" id="analysis-ai-chat-btn">
                    <i class="fa-solid fa-robot"></i> Tanya AI Assistant
                </a>
            </div>
        </div>
    </div>

</div>
