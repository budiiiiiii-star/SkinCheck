<!-- Admin Dashboard Page -->

<!-- Hero Banner -->
<div class="hero-banner slide-up">
    <div style="position:relative;z-index:1;">
        <div class="hero-banner-title"><i class="fa-solid fa-gauge me-2"></i>Dashboard Overview</div>
        <p class="hero-banner-subtitle">Pantau statistik platform SkinCheck secara real-time.</p>
    </div>
</div>

<!-- Stats Grid -->
<div class="row g-4 mb-5 slide-up">
    <!-- Total Customers -->
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-card-icon stat-card-icon-purple">
                <i class="fa-solid fa-users"></i>
            </div>
            <div>
                <div class="stat-card-label">Total Customers</div>
                <div class="stat-card-value"><%= metrics.totalUsers %></div>
                <div class="stat-card-sub">
                    <span style="color:#10b981;font-weight:600;"><%= metrics.activeUsers %> aktif</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Face Scans -->
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-card-icon stat-card-icon-cyan">
                <i class="fa-solid fa-camera"></i>
            </div>
            <div>
                <div class="stat-card-label">Total Face Scans</div>
                <div class="stat-card-value"><%= metrics.totalScans %></div>
                <div class="stat-card-sub">
                    <span style="color:var(--brand-primary);font-weight:600;">+<%= metrics.scansToday %> hari ini</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Sunscreen Checks -->
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-card-icon stat-card-icon-amber">
                <i class="fa-solid fa-sun"></i>
            </div>
            <div>
                <div class="stat-card-label">Sunscreen Checks</div>
                <div class="stat-card-value"><%= metrics.totalSunscreenChecks %></div>
                <div class="stat-card-sub">
                    <span style="color:#f59e0b;font-weight:600;">+<%= metrics.sunscreenChecksToday %> hari ini</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Successful Analysis -->
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="stat-card-icon stat-card-icon-green">
                <i class="fa-solid fa-chart-line"></i>
            </div>
            <div>
                <div class="stat-card-label">Successful Analysis</div>
                <div class="stat-card-value"><%= metrics.analysisSuccess %></div>
                <div class="stat-card-sub">
                    <span style="color:#ef4444;font-weight:600;"><%= metrics.analysisFailed %> gagal</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Links -->
<div style="margin-bottom:24px;">
    <h2 style="font-size:1rem;font-weight:700;color:var(--text-primary);margin-bottom:16px;">Navigasi Cepat</h2>
    <div class="row g-3">
        <div class="col-sm-6 col-lg-3">
            <a href="/admin/users" style="display:flex;align-items:center;gap:14px;background:var(--bg-card);border:1px solid var(--border-color);border-radius:16px;padding:18px 20px;transition:all 0.2s;text-decoration:none;" 
               onmouseenter="this.style.boxShadow='var(--shadow-md)';this.style.borderColor='var(--border-hover)';this.style.transform='translateY(-2px)'"
               onmouseleave="this.style.boxShadow='';this.style.borderColor='var(--border-color)';this.style.transform=''">
                <div style="width:44px;height:44px;border-radius:12px;background:rgba(124,58,237,0.1);display:flex;align-items:center;justify-content:center;color:var(--brand-primary);font-size:1.1rem;">
                    <i class="fa-solid fa-users"></i>
                </div>
                <div>
                    <div style="font-weight:700;color:var(--text-primary);font-size:0.9rem;">Kelola Pengguna</div>
                    <div style="font-size:0.75rem;color:var(--text-muted);">Lihat & manajemen akun</div>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-lg-3">
            <a href="/admin/products" style="display:flex;align-items:center;gap:14px;background:var(--bg-card);border:1px solid var(--border-color);border-radius:16px;padding:18px 20px;transition:all 0.2s;text-decoration:none;"
               onmouseenter="this.style.boxShadow='var(--shadow-md)';this.style.borderColor='var(--border-hover)';this.style.transform='translateY(-2px)'"
               onmouseleave="this.style.boxShadow='';this.style.borderColor='var(--border-color)';this.style.transform=''">
                <div style="width:44px;height:44px;border-radius:12px;background:rgba(6,182,212,0.1);display:flex;align-items:center;justify-content:center;color:#06b6d4;font-size:1.1rem;">
                    <i class="fa-solid fa-box"></i>
                </div>
                <div>
                    <div style="font-weight:700;color:var(--text-primary);font-size:0.9rem;">Kelola Produk</div>
                    <div style="font-size:0.75rem;color:var(--text-muted);">Katalog rekomendasi</div>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-lg-3">
            <a href="/admin/scans" style="display:flex;align-items:center;gap:14px;background:var(--bg-card);border:1px solid var(--border-color);border-radius:16px;padding:18px 20px;transition:all 0.2s;text-decoration:none;"
               onmouseenter="this.style.boxShadow='var(--shadow-md)';this.style.borderColor='var(--border-hover)';this.style.transform='translateY(-2px)'"
               onmouseleave="this.style.boxShadow='';this.style.borderColor='var(--border-color)';this.style.transform=''">
                <div style="width:44px;height:44px;border-radius:12px;background:rgba(16,185,129,0.1);display:flex;align-items:center;justify-content:center;color:#10b981;font-size:1.1rem;">
                    <i class="fa-solid fa-microscope"></i>
                </div>
                <div>
                    <div style="font-weight:700;color:var(--text-primary);font-size:0.9rem;">Riwayat Scan</div>
                    <div style="font-size:0.75rem;color:var(--text-muted);">Log & data analisis</div>
                </div>
            </a>
        </div>
        <div class="col-sm-6 col-lg-3">
            <a href="/admin/settings" style="display:flex;align-items:center;gap:14px;background:var(--bg-card);border:1px solid var(--border-color);border-radius:16px;padding:18px 20px;transition:all 0.2s;text-decoration:none;"
               onmouseenter="this.style.boxShadow='var(--shadow-md)';this.style.borderColor='var(--border-hover)';this.style.transform='translateY(-2px)'"
               onmouseleave="this.style.boxShadow='';this.style.borderColor='var(--border-color)';this.style.transform=''">
                <div style="width:44px;height:44px;border-radius:12px;background:rgba(245,158,11,0.1);display:flex;align-items:center;justify-content:center;color:#f59e0b;font-size:1.1rem;">
                    <i class="fa-solid fa-sliders"></i>
                </div>
                <div>
                    <div style="font-weight:700;color:var(--text-primary);font-size:0.9rem;">Konfigurasi API</div>
                    <div style="font-size:0.75rem;color:var(--text-muted);">Setelan AI & Fonnte WA</div>
                </div>
            </a>
        </div>
    </div>
</div>
