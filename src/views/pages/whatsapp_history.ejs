<!-- whatsapp_history.ejs -->
<div class="page-header mb-4">
    <h2 class="page-title"><i class="fa-solid fa-clock-rotate-left me-2"></i>Riwayat Cek WhatsApp</h2>
    <p class="text-muted">Semua riwayat pengecekan nomor WhatsApp Anda.</p>
</div>

<% if (typeof error !== 'undefined' && error) { %>
<div class="alert alert-danger"><i class="fa-solid fa-circle-exclamation me-2"></i><%= error %></div>
<% } %>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fw-bold fs-3 text-primary"><%= stats.total || 0 %></div>
            <div class="small text-muted">Total</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fw-bold fs-3 text-success"><%= stats.registered || 0 %></div>
            <div class="small text-muted">Terdaftar</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fw-bold fs-3 text-danger"><%= stats.not_registered || 0 %></div>
            <div class="small text-muted">Tidak Terdaftar</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm text-center p-3">
            <div class="fw-bold fs-3 text-warning"><%= stats.failed || 0 %></div>
            <div class="small text-muted">Gagal</div>
        </div>
    </div>
</div>

<!-- Filter & Search -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="GET" action="/whatsapp/history" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-medium mb-1">Cari Nomor</label>
                <input type="text" class="form-control" name="search" value="<%= filters.search %>" placeholder="08123456789...">
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-medium mb-1">Filter Status</label>
                <select class="form-select" name="status">
                    <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>Semua Status</option>
                    <option value="registered" <%= filters.status === 'registered' ? 'selected' : '' %>>Terdaftar</option>
                    <option value="not_registered" <%= filters.status === 'not_registered' ? 'selected' : '' %>>Tidak Terdaftar</option>
                    <option value="verification_failed" <%= filters.status === 'verification_failed' ? 'selected' : '' %>>Gagal</option>
                    <option value="invalid_number" <%= filters.status === 'invalid_number' ? 'selected' : '' %>>Nomor Tidak Valid</option>
                    <option value="unknown" <%= filters.status === 'unknown' ? 'selected' : '' %>>Unknown</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">Filter</button>
                <a href="/whatsapp/history" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <% if (history.data.length === 0) { %>
        <div class="text-center py-5">
            <i class="fa-solid fa-inbox fa-3x text-muted mb-3"></i>
            <p class="text-muted">Belum ada riwayat pengecekan.</p>
            <a href="/whatsapp/verify" class="btn btn-success">
                <i class="fa-brands fa-whatsapp me-2"></i>Cek Nomor Sekarang
            </a>
        </div>
        <% } else { %>
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">#</th>
                        <th>Nomor Input</th>
                        <th>Nomor (Normalized)</th>
                        <th>Status</th>
                        <th>Waktu</th>
                    </tr>
                </thead>
                <tbody>
                    <% history.data.forEach((row, i) => { %>
                    <tr>
                        <td class="ps-4 text-muted small"><%= ((history.page - 1) * history.limit) + i + 1 %></td>
                        <td class="font-monospace"><%= row.phone_input %></td>
                        <td class="font-monospace text-muted"><%= row.phone_norm %></td>
                        <td>
                            <% if (row.status === 'registered') { %>
                                <span class="badge bg-success"><i class="fa-brands fa-whatsapp me-1"></i>Terdaftar</span>
                            <% } else if (row.status === 'not_registered') { %>
                                <span class="badge bg-danger">Tidak Terdaftar</span>
                            <% } else if (row.status === 'verification_failed') { %>
                                <span class="badge bg-warning text-dark">Gagal</span>
                            <% } else if (row.status === 'invalid_number') { %>
                                <span class="badge bg-secondary">Nomor Invalid</span>
                            <% } else { %>
                                <span class="badge bg-light text-dark border">Unknown</span>
                            <% } %>
                        </td>
                        <td class="small text-muted"><%= new Date(row.created_at).toLocaleString('id-ID') %></td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <% if (history.totalPages > 1) { %>
        <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
            <div class="small text-muted">
                Menampilkan <%= ((history.page-1)*history.limit)+1 %>–<%= Math.min(history.page*history.limit, history.total) %> dari <%= history.total %> hasil
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <% for (let p = 1; p <= history.totalPages; p++) { %>
                    <li class="page-item <%= p === history.page ? 'active' : '' %>">
                        <a class="page-link" href="?page=<%= p %>&status=<%= filters.status %>&search=<%= filters.search %>"><%= p %></a>
                    </li>
                    <% } %>
                </ul>
            </nav>
        </div>
        <% } %>
        <% } %>
    </div>
</div>
