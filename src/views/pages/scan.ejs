<div class="row w-100 justify-content-center mt-4 mb-5">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden bg-white glass-effect">
            <div class="card-header bg-primary text-white p-4">
                <h3 class="fw-bold mb-0"><i class="fa-solid fa-camera me-2"></i> Face Scan</h3>
                <p class="mb-0 mt-1 small opacity-75">Ikuti panduan framing untuk hasil optimal.</p>
            </div>
            
            <div class="card-body p-4 text-center position-relative">
                
                <!-- Camera Permission Info -->
                <div id="permission-info" class="my-5">
                    <i class="fa-solid fa-camera-rotate fs-1 text-primary mb-3"></i>
                    <h5 class="fw-bold">Akses Kamera Diperlukan</h5>
                    <p class="text-muted">SkinCheck membutuhkan akses ke kamera perangkat Anda untuk melakukan Face Scan. Hasil foto akan disimpan secara aman dan private.</p>
                    <button id="start-camera-btn" class="btn btn-primary btn-lg mt-2 btn-glow">Izinkan & Buka Kamera</button>
                    <div id="camera-error" class="alert alert-danger mt-3 d-none"></div>
                </div>

                <!-- Live Camera View -->
                <div id="camera-container" class="position-relative d-none" style="width: 100%; max-width: 520px; margin: 0 auto; border-radius: 20px; overflow: hidden; background: linear-gradient(160deg, #0a0a1a 0%, #0d1b2a 60%, #0a1628 100%); box-shadow: 0 0 60px rgba(0,200,255,0.15), 0 20px 60px rgba(0,0,0,0.6);">
                    <video id="camera-video" class="w-100" autoplay playsinline style="transform: scaleX(-1); opacity: 0.92;"></video>

                    <!-- Framing Guide Overlay -->
                    <div id="framing-guide" class="position-absolute top-0 start-0 w-100 h-100 pointer-events-none" style="display: flex; align-items: center; justify-content: center;">
                        <!-- Dark overlay with face-shaped cutout using SVG -->
                        <svg id="face-svg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                <mask id="face-mask">
                                    <rect width="100%" height="100%" fill="white"/>
                                    <ellipse cx="50%" cy="50%" rx="22%" ry="38%" fill="black"/>
                                </mask>
                                <filter id="glow">
                                    <feGaussianBlur stdDeviation="4" result="coloredBlur"/>
                                    <feMerge>
                                        <feMergeNode in="coloredBlur"/>
                                        <feMergeNode in="SourceGraphic"/>
                                    </feMerge>
                                </filter>
                                <linearGradient id="ovalGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#00e5ff" stop-opacity="1">
                                        <animate attributeName="stop-color" values="#00e5ff;#0080ff;#00e5ff" dur="3s" repeatCount="indefinite"/>
                                    </stop>
                                    <stop offset="50%" stop-color="#0080ff" stop-opacity="1">
                                        <animate attributeName="stop-color" values="#0080ff;#00e5ff;#0080ff" dur="3s" repeatCount="indefinite"/>
                                    </stop>
                                    <stop offset="100%" stop-color="#00e5ff" stop-opacity="1">
                                        <animate attributeName="stop-color" values="#00e5ff;#0080ff;#00e5ff" dur="3s" repeatCount="indefinite"/>
                                    </stop>
                                </linearGradient>
                            </defs>

                            <!-- Dark overlay outside the oval -->
                            <rect width="100%" height="100%" fill="rgba(5,10,30,0.62)" mask="url(#face-mask)"/>

                            <!-- Outer glow ellipse (soft) -->
                            <ellipse cx="50%" cy="50%" rx="24%" ry="40.5%" fill="none" stroke="rgba(0,200,255,0.18)" stroke-width="12" filter="url(#glow)"/>

                            <!-- Main glowing oval border -->
                            <ellipse cx="50%" cy="50%" rx="22%" ry="38%" fill="none" stroke="url(#ovalGradient)" stroke-width="2.8" filter="url(#glow)">
                                <animate attributeName="stroke-opacity" values="0.85;1;0.85" dur="2s" repeatCount="indefinite"/>
                            </ellipse>

                            <!-- Rotating dashed scan ring -->
                            <ellipse cx="50%" cy="50%" rx="22%" ry="38%" fill="none" stroke="rgba(0,220,255,0.55)" stroke-width="1.5" stroke-dasharray="18 10" stroke-linecap="round">
                                <animateTransform attributeName="transform" type="rotate" from="0 260 195" to="360 260 195" dur="5s" repeatCount="indefinite"/>
                            </ellipse>

                            <!-- Corner accent dots -->
                            <circle cx="50%" cy="4%" r="3" fill="#00e5ff" opacity="0.7">
                                <animate attributeName="opacity" values="0.4;1;0.4" dur="2s" repeatCount="indefinite"/>
                            </circle>
                            <circle cx="50%" cy="96%" r="3" fill="#00e5ff" opacity="0.7">
                                <animate attributeName="opacity" values="0.4;1;0.4" dur="2s" begin="0.5s" repeatCount="indefinite"/>
                            </circle>
                        </svg>
                    </div>

                    <!-- Live Guidance Tips -->
                    <div id="live-guidance" class="position-absolute bottom-0 start-0 w-100 text-center" style="padding: 10px 16px 14px; background: linear-gradient(to top, rgba(0,10,30,0.9) 0%, transparent 100%); font-size: 0.85rem; font-weight: 500; letter-spacing: 0.3px;">
                        <span style="color: #00e5ff;">●</span> <span style="color: #e0f7ff;">Posisikan wajah Anda di dalam bingkai</span>
                    </div>
                </div>

                <!-- Hidden Canvas for Capture -->
                <canvas id="capture-canvas" class="d-none"></canvas>
                
                <!-- Captured Image Preview -->
                <div id="preview-container" class="d-none mt-3">
                    <img id="capture-preview" class="img-fluid rounded-4 shadow-sm" style="max-width: 500px; transform: scaleX(-1);">
                    <div id="validation-message" class="alert mt-3 d-none"></div>
                </div>

                <!-- Actions -->
                <div id="camera-actions" class="mt-4 d-none">
                    <button id="capture-btn" class="btn btn-primary btn-lg rounded-pill px-5 btn-glow shadow-sm">
                        <i class="fa-solid fa-camera"></i> Ambil Foto
                    </button>
                </div>
                
                <div id="preview-actions" class="mt-4 d-none gap-2 justify-content-center d-flex">
                    <button id="retake-btn" class="btn btn-outline-secondary btn-lg rounded-pill px-4">Ulangi</button>
                    <button id="upload-btn" class="btn btn-success btn-lg rounded-pill px-4 btn-glow">Gunakan Foto Ini</button>
                </div>
                
                <!-- Loading state -->
                <div id="loading-state" class="mt-4 d-none">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Menganalisis dan Menyimpan...</p>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    const startCameraBtn = document.getElementById('start-camera-btn');
    const permissionInfo = document.getElementById('permission-info');
    const cameraError = document.getElementById('camera-error');
    const cameraContainer = document.getElementById('camera-container');
    const video = document.getElementById('camera-video');
    const liveGuidance = document.getElementById('live-guidance');
    
    const captureBtn = document.getElementById('capture-btn');
    const cameraActions = document.getElementById('camera-actions');
    
    const canvas = document.getElementById('capture-canvas');
    const previewContainer = document.getElementById('preview-container');
    const capturePreview = document.getElementById('capture-preview');
    const previewActions = document.getElementById('preview-actions');
    const validationMessage = document.getElementById('validation-message');
    
    const retakeBtn = document.getElementById('retake-btn');
    const uploadBtn = document.getElementById('upload-btn');
    const loadingState = document.getElementById('loading-state');
    
    let stream = null;
    let base64Image = null;

    // Start Camera
    startCameraBtn.addEventListener('click', async () => {
        try {
            stream = await navigator.mediaDevices.getUserMedia({ 
                video: { facingMode: 'user', width: { ideal: 1280 }, height: { ideal: 720 } }, 
                audio: false 
            });
            video.srcObject = stream;
            
            permissionInfo.classList.add('d-none');
            cameraContainer.classList.remove('d-none');
            cameraActions.classList.remove('d-none');
            
            // Mock dynamic guidance
            simulateGuidance();
            
        } catch (err) {
            console.error('Camera error:', err);
            cameraError.textContent = 'Gagal mengakses kamera: ' + err.message;
            cameraError.classList.remove('d-none');
        }
    });
    
    // Simulate framing tips (Mock logic for frontend framing UI)
    let guidanceInterval;
    function simulateGuidance() {
        const tips = [
            "Posisikan wajah Anda di dalam bingkai",
            "Pastikan pencahayaan cukup",
            "Jangan terlalu dekat dengan kamera",
            "Tahan posisi Anda, bagus!"
        ];
        let i = 0;
        guidanceInterval = setInterval(() => {
            liveGuidance.innerHTML = `<span style="color:#00e5ff;">●</span> <span style="color:#e0f7ff;">${tips[i % tips.length]}</span>`;
            i++;
        }, 3000);
    }

    // Stop Camera
    function stopCamera() {
        if (stream) {
            stream.getTracks().forEach(track => track.stop());
        }
        clearInterval(guidanceInterval);
    }

    // Capture Image
    captureBtn.addEventListener('click', () => {
        // Set canvas size to video size
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;
        
        const context = canvas.getContext('2d');
        // We do not flip here, we just draw what the camera sees. The flip is handled in CSS if needed, 
        // but typically backend wants un-flipped or it doesn't matter for AI analysis.
        context.drawImage(video, 0, 0, canvas.width, canvas.height);
        
        base64Image = canvas.toDataURL('image/jpeg', 0.9);
        capturePreview.src = base64Image;
        
        // UI changes
        cameraContainer.classList.add('d-none');
        cameraActions.classList.add('d-none');
        
        previewContainer.classList.remove('d-none');
        previewActions.classList.remove('d-none');
        validationMessage.classList.add('d-none');
    });

    // Retake
    retakeBtn.addEventListener('click', () => {
        base64Image = null;
        previewContainer.classList.add('d-none');
        previewActions.classList.add('d-none');
        
        cameraContainer.classList.remove('d-none');
        cameraActions.classList.remove('d-none');
    });

    // Upload
    uploadBtn.addEventListener('click', async () => {
        if (!base64Image) return;
        
        previewActions.classList.add('d-none');
        loadingState.classList.remove('d-none');
        validationMessage.classList.add('d-none');
        
        try {
            const response = await fetch('/scan/upload', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ imageBase64: base64Image })
            });
            
            const result = await response.json();
            
            loadingState.classList.add('d-none');
            validationMessage.classList.remove('d-none');
            
            if (result.success) {
                validationMessage.className = 'alert alert-success mt-3';
                validationMessage.innerHTML = `<i class="fa-solid fa-check-circle"></i> ${result.message}`;
                stopCamera();
                
                // Redirect to analysis page after 2 seconds
                setTimeout(() => {
                    window.location.href = '/analysis/' + result.scanId;
                }, 2000);
            } else {
                validationMessage.className = 'alert alert-danger mt-3';
                validationMessage.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> ${result.message} <br> <small>${JSON.stringify(result.details)}</small>`;
                previewActions.classList.remove('d-none'); // allow retake
            }
            
        } catch (err) {
            console.error(err);
            loadingState.classList.add('d-none');
            validationMessage.className = 'alert alert-danger mt-3';
            validationMessage.innerHTML = `<i class="fa-solid fa-triangle-exclamation"></i> Terjadi kesalahan jaringan.`;
            previewActions.classList.remove('d-none');
            validationMessage.classList.remove('d-none');
        }
    });
});
</script>
