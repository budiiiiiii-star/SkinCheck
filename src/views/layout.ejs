<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.title || 'SkinCheck - AI-Powered Skin Health' %></title>
    <meta name="description" content="SkinCheck — Platform pemantauan kesehatan kulit berbasis AI. Analisis visual kulit, deteksi sunscreen, dan asisten skincare personal.">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS (utilities only) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<% if (!locals.user) { %>
    <%- body %>
<% } else { %>

<!-- Sidebar Overlay (mobile) -->
<div class="sidebar-overlay" id="sidebar-overlay"></div>

<!-- App Shell -->
<div class="app-shell">

    <!-- ============================================================
         SIDEBAR
         ============================================================ -->
    <aside class="sidebar" id="sidebar">

        <!-- Brand -->
        <div class="sidebar-brand">
            <div class="sidebar-brand-icon">
                <i class="fa-solid fa-leaf"></i>
            </div>
            <span class="sidebar-brand-name">SkinCheck</span>
        </div>

        <!-- User Info -->
        <% const profileLink = user.role === 'ADMIN' ? '/admin/settings' : '/profile'; %>
        <a href="<%= profileLink %>" class="sidebar-user" style="text-decoration:none;" title="Klik untuk ubah profil / nama">
            <div class="sidebar-user-avatar">
                <%= user.name.charAt(0).toUpperCase() %>
            </div>
            <div class="sidebar-user-info">
                <div class="sidebar-user-name"><%= user.name %></div>
                <div class="sidebar-user-role"><%= user.role === 'ADMIN' ? 'Administrator' : 'Customer' %> <i class="fa-solid fa-pen-to-square ms-1" style="font-size:0.65rem;opacity:0.6;"></i></div>
            </div>
        </a>

        <!-- Navigation -->
        <nav class="sidebar-nav">

            <% if (user.role === 'ADMIN') { %>
                <!-- ADMIN MENU -->
                <div class="sidebar-section-label">Admin Panel</div>
                <a href="/admin/dashboard" class="sidebar-item <%= locals.title && locals.title.includes('Admin Dashboard') ? 'active' : '' %>">
                    <span class="sidebar-item-icon"><i class="fa-solid fa-gauge"></i></span>
                    Dashboard
                </a>
                <a href="/admin/users" class="sidebar-item <%= locals.title && locals.title.includes('Pengguna') ? 'active' : '' %>">
                    <span class="sidebar-item-icon"><i class="fa-solid fa-users"></i></span>
                    Pengguna
                </a>
                <a href="/admin/products" class="sidebar-item <%= locals.title && locals.title.includes('Produk') ? 'active' : '' %>">
                    <span class="sidebar-item-icon"><i class="fa-solid fa-box"></i></span>
                    Produk
                </a>
                <a href="/admin/scans" class="sidebar-item <%= locals.title && locals.title.includes('Scan') ? 'active' : '' %>">
                    <span class="sidebar-item-icon"><i class="fa-solid fa-camera"></i></span>
                    Riwayat Scan
                </a>
                <a href="/admin/settings" class="sidebar-item <%= locals.title && locals.title.includes('Konfigurasi') ? 'active' : '' %>">
                    <span class="sidebar-item-icon"><i class="fa-solid fa-sliders"></i></span>
                    Konfigurasi AI & WA
                </a>
            <% } else { %>
                <!-- CUSTOMER MENU -->
                <div class="sidebar-section-label">Utama</div>
                <a href="/customer/dashboard" class="sidebar-item <%= locals.title && locals.title.includes('Dashboard') ? 'active' : '' %>">
                    <span class="sidebar-item-icon"><i class="fa-solid fa-house"></i></span>
                    Dashboard
                </a>
                <a href="/scan" class="sidebar-item <%= locals.title && locals.title.includes('Face Scan') ? 'active' : '' %>">
                    <span class="sidebar-item-icon"><i class="fa-solid fa-camera"></i></span>
                    Face Scan
                </a>
                <a href="/sunscreen/scan" class="sidebar-item <%= locals.title && locals.title.includes('Sunscreen') ? 'active' : '' %>">
                    <span class="sidebar-item-icon"><i class="fa-solid fa-sun"></i></span>
                    Cek Sunscreen
                </a>

                <div class="sidebar-section-label">Insights</div>
                <a href="/customer/recommendations" class="sidebar-item <%= locals.title && locals.title.includes('Rekomendasi') ? 'active' : '' %>">
                    <span class="sidebar-item-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></span>
                    Rekomendasi
                </a>

                <div class="sidebar-section-label">Akun</div>
                <a href="/profile" class="sidebar-item <%= locals.title && locals.title.includes('Profil') ? 'active' : '' %>">
                    <span class="sidebar-item-icon"><i class="fa-solid fa-circle-user"></i></span>
                    Edit Profil
                </a>
            <% } %>

        </nav>

        <!-- Sidebar Footer -->
        <div class="sidebar-footer">
            <a href="/logout" class="sidebar-item">
                <span class="sidebar-item-icon"><i class="fa-solid fa-right-from-bracket"></i></span>
                Logout
            </a>
        </div>
    </aside>

    <!-- ============================================================
         MAIN CONTENT
         ============================================================ -->
    <div class="main-content">

        <!-- Topbar -->
        <header class="topbar">
            <div class="topbar-left">
                <!-- Mobile menu toggle -->
                <button class="sidebar-mobile-toggle" id="sidebar-toggle" aria-label="Toggle Sidebar">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <span class="topbar-page-title"><%= locals.title || 'SkinCheck' %></span>
            </div>
            <div class="topbar-right">
                <% if (locals.user && locals.user.role === 'ADMIN') { %>
                <!-- Notification Bell for Admin -->
                <div class="notif-wrapper" id="admin-notif-wrapper">
                    <button class="notif-bell-btn" id="notif-bell-btn" aria-label="Notifikasi Admin" title="Notifikasi Pengguna Baru">
                        <i class="fa-regular fa-bell"></i>
                        <span class="notif-badge" id="notif-badge" style="display:none;">0</span>
                    </button>

                    <!-- Dropdown Panel -->
                    <div class="notif-dropdown" id="notif-dropdown">
                        <div class="notif-header">
                            <div class="notif-header-title">
                                <i class="fa-solid fa-bell"></i>
                                <span>Notifikasi Admin</span>
                            </div>
                            <button type="button" class="notif-mark-all" id="notif-mark-all-btn">
                                Tandai Dibaca
                            </button>
                        </div>
                        <div class="notif-list" id="notif-list">
                            <div class="notif-empty"><i class="fa-solid fa-spinner fa-spin"></i> Memuat notifikasi...</div>
                        </div>
                        <div class="notif-footer">
                            <a href="/admin/users" class="notif-view-all">Lihat Semua Pengguna <i class="fa-solid fa-arrow-right"></i></a>
                        </div>
                    </div>
                </div>
                <% } %>

                <!-- Dark/Light Mode Toggle -->
                <button class="theme-toggle" id="theme-toggle" title="Toggle Dark/Light Mode" aria-label="Toggle Dark/Light Mode">
                    <div class="theme-toggle-icons">
                        <i class="fa-solid fa-sun" style="font-size:0.6rem; color: #f59e0b;"></i>
                        <i class="fa-solid fa-moon" style="font-size:0.6rem; color: #7c3aed;"></i>
                    </div>
                    <div class="theme-toggle-thumb" id="theme-thumb">
                        <i class="fa-solid fa-sun" style="font-size:0.5rem;"></i>
                    </div>
                </button>
            </div>
        </header>

        <!-- Page Body -->
        <main class="page-content fade-in">
            <%- body %>
        </main>

    </div><!-- end .main-content -->

</div><!-- end .app-shell -->

<!-- Chatbot Widget -->
<%- include('partials/chatbot_widget') %>

<% } %>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
// ============================================================
// THEME TOGGLE (Dark / Light)
// ============================================================
(function() {
    const html = document.documentElement;
    const savedTheme = localStorage.getItem('sc-theme') || 'light';
    html.setAttribute('data-theme', savedTheme);

    const themeBtn = document.getElementById('theme-toggle');
    const themeThumb = document.getElementById('theme-thumb');

    function updateThumbIcon(theme) {
        if (!themeThumb) return;
        themeThumb.innerHTML = theme === 'dark'
            ? '<i class="fa-solid fa-moon" style="font-size:0.5rem;"></i>'
            : '<i class="fa-solid fa-sun" style="font-size:0.5rem;"></i>';
    }

    updateThumbIcon(savedTheme);

    if (themeBtn) {
        themeBtn.addEventListener('click', () => {
            const current = html.getAttribute('data-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            html.setAttribute('data-theme', next);
            localStorage.setItem('sc-theme', next);
            updateThumbIcon(next);
        });
    }
})();

// ============================================================
// SIDEBAR TOGGLE (Mobile)
// ============================================================
(function() {
    const toggleBtn = document.getElementById('sidebar-toggle');
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebar-overlay');

    if (!toggleBtn || !sidebar) return;

    function openSidebar() {
        sidebar.classList.add('sidebar-open');
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
        sidebar.classList.remove('sidebar-open');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
    }

    toggleBtn.addEventListener('click', () => {
        if (sidebar.classList.contains('sidebar-open')) {
            closeSidebar();
        } else {
            openSidebar();
        }
    });

    overlay.addEventListener('click', closeSidebar);
})();

<% if (locals.user && locals.user.role === 'ADMIN') { %>
// ============================================================
// ADMIN NOTIFICATIONS HANDLER
// ============================================================
(function() {
    const bellBtn = document.getElementById('notif-bell-btn');
    const dropdown = document.getElementById('notif-dropdown');
    const badge = document.getElementById('notif-badge');
    const notifList = document.getElementById('notif-list');
    const markAllBtn = document.getElementById('notif-mark-all-btn');

    if (!bellBtn || !dropdown) return;

    let previousUnread = 0;
    let isOpen = false;

    // Toggle dropdown
    bellBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        isOpen = !isOpen;
        dropdown.classList.toggle('show', isOpen);
        if (isOpen) {
            loadNotifications();
        }
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
        if (!dropdown.contains(e.target) && !bellBtn.contains(e.target)) {
            dropdown.classList.remove('show');
            isOpen = false;
        }
    });

    // Mark all as read
    if (markAllBtn) {
        markAllBtn.addEventListener('click', async (e) => {
            e.stopPropagation();
            try {
                await fetch('/api/admin/notifications/read-all', { method: 'POST' });
                loadNotifications();
            } catch (_) {}
        });
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text || '';
        return div.innerHTML;
    }

    // Format notification HTML
    function renderNotifications(items) {
        if (!items || items.length === 0) {
            notifList.innerHTML = `
                <div class="notif-empty">
                    <i class="fa-regular fa-bell-slash" style="font-size:1.8rem;opacity:0.3;margin-bottom:8px;display:block;"></i>
                    Belum ada notifikasi pengguna baru.
                </div>
            `;
            return;
        }

        notifList.innerHTML = items.map(n => `
            <a href="/admin/users" class="notif-item ${n.is_read ? '' : 'unread'}" data-id="${n.id}">
                <div class="notif-item-icon">
                    <i class="fa-solid fa-user-plus"></i>
                </div>
                <div class="notif-item-content">
                    <div class="notif-item-title">
                        <span>${escapeHtml(n.title)}</span>
                        ${!n.is_read ? '<span class="notif-dot" title="Belum dibaca"></span>' : ''}
                    </div>
                    <div class="notif-item-desc">${escapeHtml(n.message)}</div>
                    <div class="notif-item-time"><i class="fa-regular fa-clock"></i> ${n.timeAgo}</div>
                </div>
            </a>
        `).join('');

        // Attach click handlers to mark individual read
        notifList.querySelectorAll('.notif-item.unread').forEach(item => {
            item.addEventListener('click', async () => {
                const id = item.dataset.id;
                if (id) {
                    try {
                        await fetch('/api/admin/notifications/' + id + '/read', { method: 'POST' });
                    } catch (_) {}
                }
            });
        });
    }

    // Show floating toast when a new notification arrives while browsing
    function showNotificationToast(title, message) {
        const toast = document.createElement('div');
        toast.className = 'notif-toast';
        toast.innerHTML = `
            <div class="notif-item-icon" style="background:rgba(16,185,129,0.15);color:#10b981;">
                <i class="fa-solid fa-user-check"></i>
            </div>
            <div>
                <strong style="font-size:0.82rem;display:block;color:var(--text-primary);">${escapeHtml(title)}</strong>
                <span style="font-size:0.75rem;color:var(--text-secondary);">${escapeHtml(message)}</span>
            </div>
        `;
        document.body.appendChild(toast);
        setTimeout(() => {
            toast.style.opacity = '0';
            toast.style.transition = 'opacity 0.5s ease';
            setTimeout(() => toast.remove(), 500);
        }, 6000);
    }

    // Load from server
    async function loadNotifications(isPolling = false) {
        try {
            const res = await fetch('/api/admin/notifications');
            if (!res.ok) return;
            const data = await res.json();
            if (!data.success) return;

            // Update badge
            if (data.unreadCount > 0) {
                badge.textContent = data.unreadCount > 99 ? '99+' : data.unreadCount;
                badge.style.display = 'inline-flex';
            } else {
                badge.style.display = 'none';
            }

            // Check if unread increased during polling
            if (isPolling && data.unreadCount > previousUnread && data.notifications.length > 0) {
                const latest = data.notifications[0];
                showNotificationToast(latest.title, latest.message);
            }
            previousUnread = data.unreadCount;

            renderNotifications(data.notifications);
        } catch (_) {}
    }

    // Initial load
    loadNotifications();

    // Poll every 15 seconds so admin knows in realtime when a new user registers
    setInterval(() => loadNotifications(true), 15000);
})();
<% } %>
</script>

<script src="/js/app.js"></script>
</body>
</html>

